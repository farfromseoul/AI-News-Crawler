{
  "name": "ai-news-crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --config wrangler.jsonc --persist-to .wrangler/state --port 8787",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write apps packages workers scripts tests '*.ts' '*.json' '*.jsonc' '.github/workflows/*.yml'",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "wrangler d1 migrations apply ai-sig --local --persist-to .wrangler/state",
    "collect": "tsx scripts/collect.ts",
    "test:e2e": "playwright test",
    "deploy:api": "wrangler deploy --config wrangler.jsonc",
    "deploy:collector": "wrangler deploy --config wrangler.collector.jsonc",
    "scheduler": "node scripts/scheduler.mjs",
    "test:scheduler": "node --test scripts/scheduler.test.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "he": "^1.2.0",
    "hono": "^4.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/he": "^1.2.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
