{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-signal",
  "main": "workers/api/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/openapi.json"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-sig",
      "database_id": "9efaed65-69cc-4bc6-b11e-da5bb4d43458",
      "preview_database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "vars": { "ENGAGEMENT_ENABLED": "true", "ENGAGEMENT_ORIGIN": "https://ai-signal.negroism.workers.dev" },
  "ratelimits": [{ "name": "ENGAGEMENT_LIMITER", "namespace_id": "1005", "simple": { "limit": 120, "period": 60 } }],
  "observability": { "enabled": true },
}
